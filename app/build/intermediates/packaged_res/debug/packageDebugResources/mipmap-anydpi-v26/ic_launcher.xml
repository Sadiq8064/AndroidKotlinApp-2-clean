<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon for Android 8 and up.

  The foreground keeps everything inside the 66dp safe circle of the 108dp canvas, so whichever
  mask the launcher applies (circle, squircle, rounded square) the ring is never clipped.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
